{
  "name": "reliquary-chat-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy --import tsx local.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node --use-env-proxy dist/integration/main.js",
    "migrate": "node --use-env-proxy dist/migrate.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test *.test.ts"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
