# Compose variables. Copy this file to the independent runtime directory as .env.
AGENT_IMAGE=reliquary-feishu:tested
AGENT_STATE_DIR=/absolute/local/path/agent-state
# Container process variables. Place these in agent.env (mode 0600).
# Attach the existing backend network as described in README, or use a reachable remote endpoint.
RELIQUARY_API_URL=http://app:8080
RELIQUARY_API_KEY=replace-with-existing-key
RELIQUARY_LIBRARY_IDS=replace-with-library-id
FEISHU_APP_ID=replace-with-app-id
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_TENANT_KEY=replace-with-tenant-key
FEISHU_CHAT_ID=replace-with-chat-id
AGENT_DATA_DIR=/data
AGENT_TIMEOUT_MS=120000
# Pi manages its own ChatGPT login in AGENT_DATA_DIR/auth.json.
MODEL_SOURCE=chatgpt
MODEL_API=openai-codex-responses
MODEL_NAME=gpt-6.1-sol
# Optional development setup: read an existing Codex login instead.
# CODEX_AUTH_FILE=/run/codex/auth.json
# For a customer API model, replace the block above and set all of these.
# MODEL_SOURCE=api
# MODEL_API=openai-responses
# MODEL_BASE_URL=https://your-model-service/v1
# MODEL_API_KEY=replace-with-model-key
# MODEL_CONTEXT_WINDOW=128000
# MODEL_MAX_TOKENS=8192
# Optional outbound proxy. Use an address reachable from the container.
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal
