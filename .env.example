# =====================================================================
# Reliquary 环境变量配置示例
# ---------------------------------------------------------------------
# 使用说明：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 替换所有占位符为实际值（尤其标 ⚠️ 必填 的项）
#   3. 确保 .env 不会被提交到版本控制
#
# 配置注入机制：
#   - app 服务通过 env_file: .env 读取本文件全部变量；
#   - frontend 服务无 env_file，仅消费其
#     environment 段显式列出的变量（见 docker-compose.yml）。
#
# 分组顺序：
#   A. 部署基础        镜像、运行时、网络
#   B. 数据与存储      数据库、队列、文件存储
#   D. 模型            LLM/Ollama、内置模型
#   E. 文档解析        进程内引擎、MinerU、任务超时
#   F. 认证与空间隔离  JWT/AES、单用户注册
#   J. 安全与调优      SSRF、代理、并发
# =====================================================================


# #####################################################################
# A. 部署基础
# #####################################################################

# ========== A1. 镜像版本与构建 ==========
# Reliquary 镜像版本标签：latest（稳定版）/ main（最新开发版）。升级到固定版本时，请填写目标 release 的 git tag（如 v0.7.0，注意 v 前缀），并执行 docker compose pull 拉取对应镜像。
RELIQUARY_VERSION=latest
# Alpine apk 镜像源（构建 app 镜像用，留空用默认源；国内可设 mirrors.tencent.com 加速）。
APK_MIRROR_ARG=mirrors.tencent.com
# 构建 app 镜像时是否链接 anydoc 进程内解析引擎（默认 1）。设 0 可跳过 Rust 工具链、缩短构建时间，引擎在设置页显示为不可用。
# WITH_ANYDOC=1

# ========== A2. 运行时基础 ==========
# gin 运行模式：debug（开发，详细日志）/ release（生产）。
GIN_MODE=release
# 日志级别：debug / info / warn / error / fatal，默认 debug。
# LOG_LEVEL=debug
# 日志文件路径（留空只输出 stdout）；LLM_DEBUG_LOG 开启时同目录写 llm_debug.log。
# LOG_PATH=
# 自定义日志格式模板（留空用内置默认格式）。
# LOG_FORMAT=
# LLM 调试日志：把每次大模型调用的完整请求/响应写入独立文件，排查上下文问题用。
# 可选值：true（写 LOG_PATH 同目录 llm_debug.log）/ false/空（关闭）/ 指定文件路径。
# LLM_DEBUG_LOG=true
# 时区，默认 Asia/Shanghai。影响系统时间显示与日志时间戳。
# 常用值：Asia/Shanghai, Asia/Tokyo, America/New_York, Europe/London, UTC。
TZ=Asia/Shanghai
# 系统默认语言（BCP-47），用于 Prompt 中 {{language}} 占位符回退。
# 优先级：Accept-Language 请求头 > 此变量 > 内置默认值 (en-US)。
# RELIQUARY_LANGUAGE=zh-CN
# 前端界面默认语言（BCP-47）。可选：zh-CN | en-US。
# 优先级：用户已选语言(localStorage) > 此变量 > 内置默认 zh-CN。
# 仅影响首次访问/未手动切换语言的用户；改完重启 frontend 容器即生效，无需重建镜像。
# DEFAULT_LOCALE=en-US
# 构建前端镜像时的默认语言回退（仅在不使用 Docker 运行时 config.js 时生效）。
# VITE_DEFAULT_LOCALE=en-US
# 启动时自动执行数据库迁移；设 false 禁用（默认启用）。
AUTO_MIGRATE=true
# 自动恢复脏数据迁移状态（默认 true）。
AUTO_RECOVER_DIRTY=true

# ========== A3. 网络与外部地址 ==========
# 应用服务主机名，默认 app（Docker 内部服务名）；远程后端可设远程地址。
APP_HOST=app
# 应用服务宿主机映射端口，默认 8080（仅影响宿主机访问，不影响容器间通信）。
APP_PORT=8080
# ChatGPT 登录回调须指向本机浏览器能访问的后端映射端口。
CHATGPT_CALLBACK_URL=http://127.0.0.1:8080/auth/callback
# 回调成功页面的返回链接。使用自定义前端端口时同步修改。
CHATGPT_SETTINGS_URL=http://127.0.0.1/platform/settings?section=models
# NGINX 代理到后端的目标端口，默认 8080（App 容器内部监听端口）。
# 本地部署保持默认；远程部署设为远程 App 服务的实际端口。
# APP_BACKEND_PORT=8080
# NGINX 代理到后端的协议，默认 http；远程后端为 HTTPS 时设 https。
# APP_SCHEME=http
# 前端服务端口，默认 80。
FRONTEND_PORT=80
# 文件与图片直链的外部地址，需通过 nginx 代理 /r/。
# 本地存储生成外链时使用，如 https://reliquary.example.com。
# APP_EXTERNAL_URL=
# API 响应里文件引用的默认形式：handle（默认）/ public。
#   handle — 返回内部 resource://<handle>，客户端需再调用带鉴权的 /files 代理取图。
#   public — 直接返回可加载的 http(s) 链接，第三方 App 拿到即可渲染，无需二次请求。
# 单次请求可用 ?resource_urls=handle|public 覆盖本变量，覆盖范围见 README「API 参考」。
# public 依赖上面的 APP_EXTERNAL_URL 才能生成外链；
# 无法生成时该引用保持 resource:// 原样，客户端仍可回退到 /files。
# 注意：public 会为每个被引用文件签发限时（2 小时）的匿名可读链接。
# 匿名的 embed 渠道与限定知识库的 API Key 不受本变量影响，始终返回 handle。
# 建议同时配置 SYSTEM_AES_KEY，以便复用 grant 行、稳定直链 URL 并降低读接口的写入压力。
# RESOURCE_URL_MODE=handle


# #####################################################################
# B. 数据与存储
# #####################################################################

# ========== B1. 数据库 ⚠️ 必填 ==========
# 主数据库类型：仅支持 postgres。
DB_DRIVER=postgres
# 数据库主机地址。
DB_HOST=postgres
# 数据库端口。
DB_PORT=5432
# 数据库用户名。
DB_USER=postgres
# 数据库密码。
DB_PASSWORD=postgres123!@#
# 数据库名称。
DB_NAME=Reliquary

# ========== B2. PostgreSQL 后台队列 ==========
# 任务与业务数据同库持久化，不需要额外队列服务。
# 四个独立工作池维持保底并发与弹性借用。系统设置 queue.*_concurrency
# 优先于对应环境变量；修改并发后需重启服务。
# default（文档处理主链路）
# RELIQUARY_QUEUE_CORE_CONCURRENCY=8
# entity（实体名称与文章向量重建、主题历史归入）
# RELIQUARY_QUEUE_ENRICHMENT_CONCURRENCY=12
# sync + low（数据源同步、批量删除与重新处理）
# RELIQUARY_QUEUE_MAINTENANCE_CONCURRENCY=4
# default/entity 弹性共享池，权重 3:1，不消费 sync/low
# RELIQUARY_QUEUE_SHARED_CONCURRENCY=6
# 连续重连达到此时长后，运行队列和设置页显示告警。
# RELIQUARY_QUEUE_RECONNECT_ALERT_AFTER=5m
# 后台任务每模型并发上限（0/负数禁用；前台模型测试不受其限制）
# RELIQUARY_MODEL_MAX_CONCURRENCY=32

# 同一知识库消息的近似重复阈值：64 位 SimHash 的最大 Hamming 距离，0 至 16，默认 3。
# 正文少于 100 字符不做近似检测；规范化 URL 和正文哈希始终参与检测。
# RELIQUARY_DUPLICATE_SIMHASH_DISTANCE=3

# ========== B3. 文件存储（通用）==========
# 本地文件存储根目录。
LOCAL_STORAGE_BASE_DIR=/data/files
VAULT_ROOT=/data/vault
# Article header batching, quiet time for user documents, and fallback scans.
VAULT_HEADER_DEBOUNCE=5s
VAULT_STABLE_WAIT=10m
VAULT_SCAN_INTERVAL=1m
# 统一文件大小限制（MB，默认 50）。影响知识库单文件上传、浏览器知识库校验。属部署期配置：Go/Nginx/浏览器三层启动时读一次，运行中改不生效，改后须同步重启三层。
# MAX_FILE_SIZE_MB=50

# PostgreSQL 使用 ParadeDB 镜像，提供 pgvector、pg_search 和 pg_trgm。
# 所有知识库直接使用 PostgreSQL 检索，嵌入模型在知识库中选择。

# #####################################################################
# D. 模型
# #####################################################################

# ========== D1. LLM / Ollama ==========
# 生成模型接口：OpenAI 兼容、Anthropic 原生或 Ollama；其他兼容服务选择 provider=generic 并填写地址。
# 嵌入接口：OpenAI 兼容或 Ollama。阿里云文本嵌入使用 https://dashscope.aliyuncs.com/compatible-mode/v1。
# 重排接口：通用 /rerank 或阿里云百炼。Gemini 使用 https://generativelanguage.googleapis.com/v1beta/openai/。
# Ollama 不可用时仅告警不阻断（true 时生效，默认不阻断，避免未配 Ollama 就启动失败）。
OLLAMA_OPTIONAL=true
# Ollama 服务基准 URL（连接本地/远程 Ollama）。
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 批量 embedding 大小（留空走代码默认）。
# BATCH_EMBED_SIZE=
# LLM 流原始转储（排查上下文问题；1 启用，默认目录 ~/.reliquary/investigate/llm-stream）。
# RELIQUARY_LLM_STREAM_RAW_DUMP=
# RELIQUARY_LLM_STREAM_RAW_DUMP_DIR=

# ========== D2. 内置模型声明式配置（可选）==========
# 启用 config/builtin_models.yaml（见 config/builtin_models.yaml.example）后，YAML 中的
# ${NAME} 占位符会在应用启动期从这里读取真实值。变量名由 YAML 自定，下面给出常见命名参考。
# 详见 docs/builtin-models.md。
#
# 内置生成模型
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# 内置向量模型
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# 内置 Rerank 模型
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic


# #####################################################################
# E. 文档解析
# #####################################################################

# ========== E1. 解析引擎 ==========
# simple 处理文本、Markdown 和图片；音频上传返回不支持错误。
# anydoc 在进程内处理 PDF、Office、EPUB 和 CSV，构建方法见 docs/personal-use.md。
# mineru / mineru_cloud 在设置页配置，用于扫描件与复杂排版。

# ========== E2. 文档处理 / 任务超时 ==========
# 单文档处理任务总超时（Go duration，默认 2h；大文件可调大）。
# RELIQUARY_DOCUMENT_PROCESS_TIMEOUT=2h
# 单次解析调用超时（默认 30m，须小于上一项）。
# PARSER_CALL_TIMEOUT=30m
# 知识库巡检回收（回收卡在 processing 的脏数据；false 禁用，不建议）。
# RELIQUARY_HOUSEKEEPING_ENABLED=true
# #####################################################################
# F. 认证与空间隔离
# #####################################################################

# ========== F1. 密钥 ⚠️ 必填（生产务必改默认值）==========
# JWT 签名密钥，用于前端登录刷新 Token（留空则启动时随机生成）。
JWT_SECRET=reliquary-jwt-secret
# AES-256 主密钥，用于数据库中 API Key 等敏感字段落盘加密（必须为 32 字节）。
# 加密范围：api_keys.api_key、模型 API key 等敏感字段。缺失或长度不对时已加密字段无法解密（UI 显示为空，需重填）。
# 生产必须显式设置且妥善保管，丢失则所有加密数据不可恢复。
# 注：TENANT_AES_KEY / CRYPTO_MASTER_KEY / CRYPTO_SALT 已废弃。v0.4.0 起 CryptoService（PBKDF2）被移除，加密统一改用 SYSTEM_AES_KEY。这三个变量 Go 主应用不再读取，已移除。
# 留空时 模型 API Key 与数据源凭据 将以明文保存，启动日志和系统信息页会显示此状态。
SYSTEM_AES_KEY=reliquary-system-aes-key-32bytes!!

# ========== F2. 个人空间与账号 ==========
# 首个注册账号是唯一用户，创建后自动关闭注册。
# 登录账号与有效 API Key 均可使用全部功能。
# 忘记密码可从标准输入执行 go run ./cmd/server reset-password。


# #####################################################################
# J. 安全与部署调优
# #####################################################################

# ========== J1. SSRF 防护 ==========
# SSRF 校验白名单（可选）。逗号分隔；每条可为：精确域名(api.internal)、通配域名(*.example.com)、
# IPv4(203.0.113.5)、IPv6(2001:db8::1，不带方括号)或 CIDR(10.0.0.0/8, 2001:db8::/32)。
# 列入者会在 URL 校验等地方绕过常规 SSRF 规则，生产环境请谨慎配置。
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8
#
# Docker Compose、make run 和 scripts/dev.sh app 默认追加代理 fake-ip 网段 198.18.0.0/15。
# 该网段保留用于基准测试，正常公网不会出现，兼容把公网域名解析到 fake-ip 的本机代理。
# 仍拦截回环、私网、链路本地地址和未单独放行的 Docker 服务名。
# 可设置自定义追加白名单覆盖默认值，或显式设置 SSRF_WHITELIST_EXTRA= 关闭默认放行。
# 追加白名单会与设置页的白名单合并，设置页保存为空列表也不会取消该项。
# SSRF_WHITELIST_EXTRA=198.18.0.0/15
# 宿主机开发需要访问本地服务时，可设置 SSRF_WHITELIST=localhost。
# 保留原始 URL 的图片域名白名单（可选，逗号分隔）。配置后这些域名的图片仍会下载供处理模型读取，
# markdown 中保留原始 URL，不替换为对象存储的 provider:// URL。
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# ========== J2. 代理与并发 ==========
# gin 信任的代理 CIDR（逗号分隔）。默认信任 loopback + 私网段（容器网络内 nginx 已覆盖）。
# 显式设为空字符串则禁用代理信任（ClientIP 返回直连对端）。生产部署在多层代理后需按实际填写。
# RELIQUARY_TRUSTED_PROXIES=
# ants 协程池大小（Embedding 并发，出现 429 时调小）。
CONCURRENCY_POOL_SIZE=5
